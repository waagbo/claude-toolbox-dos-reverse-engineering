#!/usr/bin/env python3
"""Print a range of a flatdis/objdump listing with LE fixups resolved.

An LE image stores object-relative values at every internal-fixup site, so
objdump prints `ds:0xbbc4` where the real flat address is 0x4bbc4. This
appends the resolved target -- and, if it lands in a --strings image, the
string literal there -- to each affected line.

    asmview LISTING -f fixups.tsv [-s obj2.bin@0x40000 ...] LO [HI]
    asmview LISTING -f fixups.tsv --func ADDR       # ADDR to the next ret
    asmview LISTING -f fixups.tsv --xref TARGET     # sites that reference TARGET

LISTING is `flatdis objN.bin BASE` output; fixups.tsv is `le-fixups` output.
HI defaults to LO+0x200. Origin: re2/tools/asmview.py (Cyberia RE project).
"""
import argparse
import re
import sys

LINE = re.compile(r'^\s+([0-9a-f]+):\t([0-9a-f ]+)\t?(.*)$')


def load_fixups(path):
    fx = {}
    for line in open(path):
        f = line.split()
        if len(f) >= 2:
            fx.setdefault(int(f[0], 16), int(f[1], 16))
    return fx


def load_images(specs):
    imgs = []
    for spec in specs or []:
        path, _, base = spec.rpartition('@')
        imgs.append((int(base, 16), open(path, 'rb').read()))
    return imgs


def string_at(imgs, a):
    for base, data in imgs:
        o = a - base
        if 0 <= o < len(data):
            end = data.find(b'\0', o)
            s = data[o:end if end >= 0 else o + 40]
            if len(s) >= 3 and all(32 <= c < 127 for c in s):
                return '  "%s"' % s.decode()
    return ''


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('listing')
    ap.add_argument('-f', '--fixups', required=True)
    ap.add_argument('-s', '--strings', action='append',
                    help='IMAGE@BASE to resolve string literals (repeatable)')
    ap.add_argument('--xref', metavar='TARGET')
    ap.add_argument('--func', metavar='ADDR')
    ap.add_argument('lo', nargs='?')
    ap.add_argument('hi', nargs='?')
    a = ap.parse_intermixed_args()
    fx = load_fixups(a.fixups)
    imgs = load_images(a.strings)

    if a.xref:
        want = int(a.xref, 16)
        for s, t in sorted(fx.items()):
            if t == want:
                print('ref from %08x' % s)
        return

    if a.func:
        lo, hi = int(a.func, 16), None
    elif a.lo:
        lo = int(a.lo, 16)
        hi = int(a.hi, 16) if a.hi else lo + 0x200
    else:
        ap.error('need LO [HI], --func or --xref')

    for line in open(a.listing):
        line = line.rstrip('\n')
        m = LINE.match(line)
        if not m:
            continue
        addr = int(m.group(1), 16)
        if addr < lo or (hi is not None and addr >= hi):
            continue
        n = len(m.group(2).split())
        hits = [(s, fx[s]) for s in range(addr, addr + n) if s in fx]
        if hits:
            tags = ' '.join('[%08x]->%08x%s' % (s, t, string_at(imgs, t))
                            for s, t in hits)
            print('%-62s ; %s' % (line, tags))
        else:
            print(line)
        if hi is None and re.match(r'\s*ret', m.group(3)):
            break


if __name__ == '__main__':
    main()

#!/usr/bin/env python3
"""Side-by-side raw asm of a candidate pair from two listings.

    xbin-diff A.asm ADDR_A B.asm ADDR_B [-n 60]

A `*` marks rows whose instruction SHAPE differs (addresses and ds:
displacements normalised away); unmarked rows differ at most in relocated
operands. Rows are aligned by position, so one inserted instruction marks
everything after it -- read the first `*` and re-anchor with a new ADDR.
"""
import argparse

from xbinlib import Listing, hexarg


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('a')
    ap.add_argument('addr_a', type=hexarg)
    ap.add_argument('b')
    ap.add_argument('addr_b', type=hexarg)
    ap.add_argument('-n', type=int, default=60)
    ap.add_argument('--addr-min', type=hexarg, default=0x8000)
    a = ap.parse_args()

    la, lb = Listing(a.a, a.addr_min), Listing(a.b, a.addr_min)
    i, j = la.at(a.addr_a), lb.at(a.addr_b)
    print('%-52s| %s' % (a.a, a.b))
    for k in range(a.n):
        ia, ib = i + k, j + k
        left = '%6x  %s' % (la.addr[ia], la.raw[ia]) if ia < len(la.addr) else ''
        right = '%6x  %s' % (lb.addr[ib], lb.raw[ib]) if ib < len(lb.addr) else ''
        same = ia < len(la.addr) and ib < len(lb.addr) and la.shape[ia] == lb.shape[ib]
        print('%-52s|%s%s' % (left, ' ' if same else '*', right))


if __name__ == '__main__':
    main()
